rules_version = '2';

// Base institucional: perfiles, matrícula y vínculos de identidad.
// Los roles vienen de custom claims asignados por la función setUserRole.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('role', null) == 'admin';
    }

    function changes(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // Perfil de la app. El usuario lo crea al registrarse y puede editarlo,
    // pero nunca puede escribirse un rol.
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['role', 'courses']);
      allow update: if signedIn() && request.auth.uid == uid
        && !changes(['role', 'courses']);
      allow delete: if isAdmin();
    }

    // Matrícula importada. TEMPORAL: el registro actual de la app lee el RUT
    // sin sesión y luego escribe linkedUid desde el cliente. Esto contradice
    // docs/identity-link-contract.md y debe migrar a requestIdentityLink.
    // Mientras tanto, solo se puede reclamar un RUT libre y para uno mismo.
    match /LCH-enroll-hn/{rut} {
      allow get: if true;
      allow list: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.get('linkedUid', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUid'])
        && request.resource.data.linkedUid == request.auth.uid
      );
      allow create, delete: if isAdmin();
    }

    // Solo las Cloud Functions escriben aquí (Admin SDK ignora las reglas).
    match /identityLinkRequests/{requestId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /identityLinks/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if false;
    }

    match /roleAssignments/{assignmentId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
