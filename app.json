{
  "expo": {
    "name": "HaNet",
    "slug": "hanetcl",
    "version": "0.9.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hanetcl",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/app-icons/ios/Fractal.icon",
      "supportsTablet": true,
      "bundleIdentifier": "art.muxp.hanetcl",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#282829",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "art.muxp.hanetcl",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#EF2274",
          "defaultChannel": "classhall"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HaNet usa tus fotos para que puedas entregar tareas y cambiar tu foto de perfil.",
          "cameraPermission": "HaNet usa la cámara para que fotografíes tus tareas y para escanear el HN-QR al pasar lista en los eventos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "HaNet usa la cámara para que fotografíes tus tareas y para escanear el HN-QR al pasar lista en los eventos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Simple",
            "android": {
              "foregroundImage": "./assets/app-icons/android/simple-foreground.png",
              "backgroundColor": "#282829"
            }
          },
          {
            "name": "ComicSans",
            "android": {
              "foregroundImage": "./assets/app-icons/android/comic-sans-foreground.png",
              "backgroundColor": "#282829"
            }
          },
          {
            "name": "TestFlight",
            "android": {
              "foregroundImage": "./assets/app-icons/android/testflight-foreground.png",
              "backgroundColor": "#4895F3"
            }
          }
        ]
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.art.muxp.hanetcl",
          "enableAndroid": true,
          "widgets": [
            {
              "name": "HaNetHoy",
              "displayName": "HaNet: tu día",
              "description": "La clase de ahora, la que sigue y tu próxima prueba.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "widgets/home-widget.tsx"
              },
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "widgets/home-widget.android.tsx"
              }
            },
            {
              "name": "HaNetCalendar",
              "displayName": "Calendar",
              "description": "Tu próxima clase y la prueba que trae, en la pantalla bloqueada.",
              "ios": {
                "supportedFamilies": [
                  "accessoryInline",
                  "accessoryCircular",
                  "accessoryRectangular"
                ],
                "initialLayout": "widgets/calendar-widget.tsx"
              },
              "android": null
            }
          ]
        }
      ],
      [
        "./plugins/with-ios-alternate-icons",
        [
          "./assets/app-icons/ios/Simple.icon",
          "./assets/app-icons/ios/ComicSans.icon",
          "./assets/app-icons/ios/TestFlight.icon"
        ]
      ],
      "./plugins/with-android-build-limits",
      "./plugins/with-android-widget-refresh",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsFileWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "iosShareExtensionName": "HaNetShare",
          "iosShareExtensionDisplayName": "HaNet",
          "iosAppGroupIdentifier": "group.art.muxp.hanetcl",
          "androidIntentFilters": [
            "application/pdf",
            "image/*",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "HaNet usa Face ID para proteger tus notas en este teléfono."
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "calendar": {
              "foregroundImage": "./assets/shortcuts/calendar.png",
              "backgroundColor": "#282829"
            },
            "classhall": {
              "foregroundImage": "./assets/shortcuts/classhall.png",
              "backgroundColor": "#282829"
            },
            "events": {
              "foregroundImage": "./assets/shortcuts/events.png",
              "backgroundColor": "#282829"
            },
            "notifications": {
              "foregroundImage": "./assets/shortcuts/notifications.png",
              "backgroundColor": "#282829"
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "releaseStage": "beta",
      "router": {},
      "eas": {
        "projectId": "e886d8e0-3ad3-4978-bbaa-1c310b001d28"
      }
    },
    "owner": "muxp",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e886d8e0-3ad3-4978-bbaa-1c310b001d28"
    }
  }
}
