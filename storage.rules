rules_version = '2';

// Firebase Storage:
//   profile-photos/{uid}/avatar.jpg        one per account, private
//   institutions/{id}/logo.png|banner.jpg  the institution's shield and banner
//   classhall-uploads/{uid}/{file}         a teacher's upload, before the
//                                          backend moves it into the Hall
//   classhall-submissions/{uid}/{file}     a student's file for a task, before
//                                          submitHallTask moves it into the Hall
//   classhall/{hallId}/...                 Hall documents and submissions: no
//                                          direct access; getHall and
//                                          getHallTask hand out token URLs
//
// Photos are private to their owner: the app does not show anyone's photo to
// other people yet. Widen `read` only together with the feature that needs it.
service firebase.storage {
  match /b/{bucket}/o {

    match /profile-photos/{uid}/avatar.jpg {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      // The app resizes before uploading; the limits stop anything else.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Institution identity: public, because emails load it from its URL and
    // Home shows it to every member. Only the HaNet team (role HNT) changes it.
    match /institutions/{institutionId}/{file} {
      allow read: if file in ['logo.png', 'banner.jpg'];
      allow delete: if request.auth != null && request.auth.token.role == 'HNT';
      allow write: if request.auth != null
        && request.auth.token.role == 'HNT'
        && file in ['logo.png', 'banner.jpg']
        && request.resource != null
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');
    }

    // A teacher uploads to their own folder; attachHallDocument checks the
    // Hall, moves the file and records it. Nobody reads this folder.
    match /classhall-uploads/{uid}/{file} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.role in ['Profesor', 'Admin', 'HNT']
        && request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|application/msword|application/vnd[.]openxmlformats-officedocument[.](wordprocessingml[.]document|presentationml[.]presentation|spreadsheetml[.]sheet)|application/vnd[.]ms-(powerpoint|excel)|image/(jpeg|png)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Any account uploads its own task files here; submitHallTask checks the
    // Hall and the task and moves them. Nobody reads this folder.
    match /classhall-submissions/{uid}/{file} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|application/msword|application/vnd[.]openxmlformats-officedocument[.](wordprocessingml[.]document|presentationml[.]presentation|spreadsheetml[.]sheet)|application/vnd[.]ms-(powerpoint|excel)|image/(jpeg|png|heic|heif|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
